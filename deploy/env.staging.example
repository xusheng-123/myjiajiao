# ============================================================
# 润物细无声 · NURTURE — Staging 环境变量模板（双主机名架构）
# 架构：www-staging.<域名> → Cloudflare Pages（前端）
#       api-staging.<域名> → Cloudflare Tunnel → Backend:8080（仅容器网）
# 用法：cp env.staging.example /etc/nurture/staging.env，把 <域名> 占位替换为真实值后
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml -f docker-compose.staging.yml --env-file /etc/nurture/staging.env up -d
# （staging 覆盖层将沙箱开关最终置为 true；其余生产加固与 Production 完全一致）
# Pages 构建变量（Cloudflare Pages 控制台配置）：NURTURE_API_HOST=api-staging.<域名>
# 纪律：本文件只允许存在 .example 模板；真实 env 文件严禁提交版本库。
# 隔离纪律：Staging 与 Production 必须使用不同的域名、JWT、数据库、运营账号。
# ============================================================

# ── Cloudflare Tunnel（人工操作获取）────────────────────────
# Cloudflare Zero Trust → Networks → Tunnels → Create tunnel 后获取
CLOUDFLARE_TUNNEL_TOKEN=eyJ...

# ── 前端 API 主机名（Pages 构建变量同名项；后端侧仅作 CORS 依据）──
# 双主机名架构：前端 www-staging.<域名>，API api-staging.<域名>
NURTURE_API_HOST=api-staging.<域名>

# ── 数据库（必填，缺失即拒启）──────────────────────────────
NURTURE_DB_PASSWORD=<强随机值 openssl rand -base64 48>

# ── 应用密钥（必填，≥256bit；与 Production 完全不同）────────
NURTURE_JWT_SECRET=<强随机值 openssl rand -base64 48>

# ── 运营引导账号（首启 BootstrapAdminRunner 创建；勿用默认手机号）──
NURTURE_ADMIN_PHONE=13900000001
NURTURE_ADMIN_PASSWORD=<强随机值>

# ── CORS（精确源，禁止通配符 *；跨源 Pages→API 必需）────────
NURTURE_CORS_ALLOWED_ORIGINS=https://www-staging.<域名>

# ── 支付边界：Staging 保留沙箱以验证支付联动全链路 ──────────
NURTURE_PAYMENT_SANDBOX_ENABLED=true
NURTURE_PAYMENT_SANDBOX_SECRET=<强随机值 openssl rand -base64 48>

# ── 生产形态安全开关（Staging 与 Production 保持一致行为）────
NURTURE_SECURITY_APIDOCSPUBLIC=false
NURTURE_ERROR_INCLUDE_MESSAGE=never
