# ============================================================
# 润物细无声 / NURTURE — Production 环境变量模板（双主机名架构）
# 架构：www.<域名> → Cloudflare Pages（前端）
#       api.<域名> → Cloudflare Tunnel → Backend:8080（仅容器网）
# 用法：cp env.production.example /etc/nurture/production.env（root:600），替换 <域名> 占位后
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file /etc/nurture/production.env up -d
# Pages 构建变量（Cloudflare Pages 控制台配置）：NURTURE_API_HOST=api.<域名>
# 纪律：真实 env 文件严禁提交版本库；泄露任一密钥按事故流程立即轮换。
# 隔离纪律：Production 与 Staging 必须使用不同域名、JWT、数据库、运营账号；本模板不得出现 staging 主机名。
# ============================================================

# ── Cloudflare Tunnel（生产独立 Tunnel，与 Staging 分离）────
CLOUDFLARE_TUNNEL_TOKEN=eyJ...

# ── 前端 API 主机名 ────────────────────────────────────────
NURTURE_API_HOST=api.<域名>

# ── 数据库（必填）──────────────────────────────────────────
NURTURE_DB_PASSWORD=<强随机值 openssl rand -base64 48>

# ── 应用密钥（必填；与 Staging 完全不同）────────────────────
NURTURE_JWT_SECRET=<强随机值 openssl rand -base64 48>

# ── 运营引导账号 ──────────────────────────────────────────
NURTURE_ADMIN_PHONE=13800000001
NURTURE_ADMIN_PASSWORD=<强随机值>

# ── CORS（精确源：真实生产前端域名，禁止通配符）────────────
NURTURE_CORS_ALLOWED_ORIGINS=https://www.<域名>

# ── 支付边界：生产强制关闭沙箱 ─────────────────────────────
# 支付上线模式（A 沙箱演示 / B 运营线下收款确认 / C 真实渠道）为产品决策项，决策记录见 deploy/RUNBOOK.md 第 6 节。
# 当前默认按模式 B 运营（线下收款确认端点已实现并实测）；接入 C 前严禁伪造商户凭据。
NURTURE_PAYMENT_SANDBOX_ENABLED=false

# ── 生产安全收口（prod 覆盖层已强制，模板显式列出便于核对）──
NURTURE_SECURITY_APIDOCSPUBLIC=false
NURTURE_ERROR_INCLUDE_MESSAGE=never
